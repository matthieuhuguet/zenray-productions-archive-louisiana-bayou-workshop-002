const REF_SRC = '../../refs/window_height_ref.png';
const NATIVE = 1254;
const lb = document.getElementById('lb');
const full = document.getElementById('full');
const refFull = document.getElementById('refFull');
const scroll = document.getElementById('scroll');
const title = document.getElementById('lbTitle');
const info = document.getElementById('lbInfo');
let cur = 0, zoom = 0, compare = false;

function applySize() {
  const avail = scroll.clientWidth - 40;
  const item = ITEMS[cur];
  const pair = compare && !item.isRef;
  const base = pair ? Math.min(NATIVE, (avail - 12) / 2) : Math.min(NATIVE, avail);
  const w = zoom === 0 ? base : NATIVE * zoom;
  full.style.width = w + 'px';
  refFull.style.width = w + 'px';
}

function show(i) {
  cur = (i + ITEMS.length) % ITEMS.length;
  const item = ITEMS[cur];
  full.src = item.src;
  refFull.src = REF_SRC;
  refFull.hidden = !(compare && !item.isRef);
  title.textContent = item.title;
  info.textContent = item.info;
  lb.classList.add('open');
  scroll.scrollTop = 0;
  scroll.scrollLeft = 0;
  applySize();
}

function zoomIn() { zoom = Math.min(4, (zoom || 1) * 1.5); applySize(); }
function zoomOut() { zoom = Math.max(0.25, (zoom || 1) / 1.5); applySize(); }
function toggleCompare() { compare = !compare; show(cur); }

document.querySelectorAll('img[data-idx]').forEach(el => {
  el.addEventListener('click', () => show(parseInt(el.dataset.idx, 10)));
});
document.getElementById('close').onclick = () => lb.classList.remove('open');
document.getElementById('prev').onclick = () => show(cur - 1);
document.getElementById('next').onclick = () => show(cur + 1);
document.getElementById('cmp').onclick = toggleCompare;
document.getElementById('zm').onclick = zoomOut;
document.getElementById('zp').onclick = zoomIn;
document.getElementById('z100').onclick = () => { zoom = 1; applySize(); };
document.getElementById('zfit').onclick = () => { zoom = 0; applySize(); };
document.addEventListener('keydown', e => {
  if (!lb.classList.contains('open')) return;
  if (e.key === 'Escape') lb.classList.remove('open');
  else if (e.key === 'ArrowRight') show(cur + 1);
  else if (e.key === 'ArrowLeft') show(cur - 1);
  else if (e.key === 'c' || e.key === 'C') toggleCompare();
  else if (e.key === '+' || e.key === '=') zoomIn();
  else if (e.key === '-') zoomOut();
  else if (e.key === '0') { zoom = 0; applySize(); }
});
window.addEventListener('resize', () => { if (lb.classList.contains('open')) applySize(); });
document.getElementById('size').oninput = e => {
  document.documentElement.style.setProperty('--tile', e.target.value + 'px');
  document.getElementById('sizeVal').textContent = e.target.value;
};
</script>
