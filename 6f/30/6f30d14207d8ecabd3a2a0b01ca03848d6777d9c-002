snippet	[ 0	locks=0 ]	(	"// 10 October 2026 (v5) : the arrow starts exactly at the top of window B on BOTH gables, the cross post is the SAME beam as the king post (one continuous swept post, no step, no overlap), the arch braces stop at the rafter underside instead of entering it, and the beams use three depth classes (rafters 1.0, posts 0.909, arms 0.818 through pscale) so no two faces ever lie in the same plane. FR : la fleche part du haut de la fenetre B sur les DEUX pignons, la croix est la MEME poutre que le poinçon, les aisseliers s'arretent sous les arbaletriers, trois profondeurs pour qu'aucune face ne soit coplanaire.
float w = ch(\"../width\");
float l = ch(\"../length\");
float wh = ch(\"../wall_height\");
float fgh = ch(\"../front_gable_height\");
float rgh = ch(\"../rear_gable_height\");
float arch_deg = ch(\"../arch_angle\");
float cross_h = ch(\"../cross_height\");
float half = ch(\"../beam_size\") * 0.5;
float win_top = getbbox_max(\"op:../../Component_WindowB/OUT_window_b_v008\").y;

float z_front = l * 0.5;
float z_rear = -l * 0.5;
float x_left = -w * 0.5;
float x_right = w * 0.5;
float SC_RAFTER = 1.0; float SC_POST = 0.909; float SC_ARM = 0.818;
float D_STOP = half * SC_RAFTER + 0.0025;   // the arm end (its cap vertices) lands 2.5 mm into the rafter underside: touching, not entering. FR : le bout de l'aisselier touche la face inferieure de l'arbaletrier.

float gables_h[] = array(fgh, rgh);
float gables_z[] = array(z_front, z_rear);
float theta = radians(clamp(arch_deg, 5.0, 89.0));

int add_pt(int geo; vector p; float sc) {
    int pt = addpoint(geo, p);
    setpointattrib(geo, \"pscale\", pt, sc);
    return pt;
}

void build_arm(int geo; float side; float y_king; float R; float th; int nseg; float z; float peak_y; float slope; float dstop; float sc) {
    int prim = addprim(geo, \"polyline\");
    float prev_perp = 1e9;
    vector prev = set(0, y_king, z);
    float sl = sqrt(1.0 + slope * slope);
    for (int i = 0; i <= nseg; ++i) {
        float phi = th * float(i) / float(nseg);
        float x = side * R * (1.0 - cos(phi));
        float y = y_king + R * sin(phi);
        vector cur = set(x, y, z);
        float perp = (peak_y - slope * abs(x) - y) / sl;
        if (i > 0 && perp <= dstop) {
            float t = (prev_perp - dstop) / max(1e-6, prev_perp - perp);
            addvertex(geo, prim, add_pt(geo, lerp(prev, cur, clamp(t, 0.0, 1.0)), sc));
            return;
        }
        addvertex(geo, prim, add_pt(geo, cur, sc));
        prev_perp = perp; prev = cur;
    }
}

for (int g = 0; g < 2; ++g) {
    float gh = gables_h[g];
    float z = gables_z[g];
    float timber_drop = half * sqrt(1.0 + pow(2.0 * gh / w, 2.0)) + 0.005;
    float peak_y = wh + gh - timber_drop;
    float slope = (2.0 * gh) / w;
    float osign = (g == 0) ? 1.0 : -1.0;          // outward direction of this gable
    float zp = z - 0.004 * osign;                 // posts sit 4 mm behind the rafter faces
    float za = z - 0.008 * osign;                 // arms 8 mm behind : no two faces share a plane

    // Rafters (own points : they carry their own depth class)
    int r_l = addprim(0, \"polyline\");
    addvertex(0, r_l, add_pt(0, set(x_left, wh - timber_drop, z), SC_RAFTER));
    addvertex(0, r_l, add_pt(0, set(0, peak_y, z), SC_RAFTER));
    int r_r = addprim(0, \"polyline\");
    addvertex(0, r_r, add_pt(0, set(x_right, wh - timber_drop, z), SC_RAFTER));
    addvertex(0, r_r, add_pt(0, set(0, peak_y, z), SC_RAFTER));

    // Arrow : starts exactly at the top of window B
    float y_pendant = win_top;
    float y_king = y_pendant + 0.12;
    float king_drop = max(0.2, peak_y - y_king);
    int p_king = addprim(0, \"polyline\");
    addvertex(0, p_king, add_pt(0, set(0, y_pendant, zp), SC_POST));
    addvertex(0, p_king, add_pt(0, set(0, peak_y, zp), SC_POST));
    if (g == 0) {
        // the cross post is the SAME beam : the king post simply continues up to the cross top
        addvertex(0, p_king, add_pt(0, set(0, wh + fgh + cross_h, zp), SC_POST));
    }

    float denom = sin(theta) + slope * (1.0 - cos(theta));
    float R = (denom > 0.001) ? (king_drop / denom) : (king_drop * 0.5);
    build_arm(0, -1.0, y_king, R, theta, 24, za, peak_y, slope, D_STOP, SC_ARM);
    build_arm(0,  1.0, y_king, R, theta, 24, za, peak_y, slope, D_STOP, SC_ARM);
}

// Crossbar on the front gable, same plane as the post, thinner in depth afterwards by cross_fix
float zc = z_front - 0.004;
float crossbar_y = wh + fgh + cross_h * 0.68;
float crossbar_half_w = cross_h * 0.26;
int prim_c_bar = addprim(0, \"polyline\");
addvertex(0, prim_c_bar, add_pt(0, set(-crossbar_half_w, crossbar_y, zc), SC_POST));
addvertex(0, prim_c_bar, add_pt(0, set( crossbar_half_w, crossbar_y, zc), SC_POST));
"	)
