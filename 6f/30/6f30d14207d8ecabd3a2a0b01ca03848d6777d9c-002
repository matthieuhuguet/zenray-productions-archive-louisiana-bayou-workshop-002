float bal_sp = ch(\"../porch_params/baluster_spacing\");

float landing_y = float(N) * sh;

function void add_box(int geo; vector pmin; vector pmax) {
    int p[];
    resize(p, 8);
    p[0] = addpoint(geo, set(pmin.x, pmin.y, pmin.z));
    p[1] = addpoint(geo, set(pmax.x, pmin.y, pmin.z));
    p[2] = addpoint(geo, set(pmax.x, pmin.y, pmax.z));
    p[3] = addpoint(geo, set(pmin.x, pmin.y, pmax.z));
    p[4] = addpoint(geo, set(pmin.x, pmax.y, pmin.z));
    p[5] = addpoint(geo, set(pmax.x, pmax.y, pmin.z));
    p[6] = addpoint(geo, set(pmax.x, pmax.y, pmax.z));
    p[7] = addpoint(geo, set(pmin.x, pmax.y, pmax.z));
    
    int pr;
    // Bottom (-Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[0]);
    // Top (+Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[4]);
    // Front (+Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[3]);
    // Back (-Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[1]);
    // Left (-X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[0]);
    // Right (+X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[2]);
}

function void add_sphere(int geo; vector center; float r) {
    int lat_div = 6;
    int lon_div = 10;
    int grid[];
    resize(grid, (lat_div + 1) * lon_div);
    
    for (int i = 0; i <= lat_div; ++i) {
        float theta = float(i) / float(lat_div) * PI;
        float y = center.y + r * cos(theta);
        float ring_r = r * sin(theta);
        for (int j = 0; j < lon_div; ++j) {
            float phi = float(j) / float(lon_div) * 2.0 * PI;
            float x = center.x + ring_r * cos(phi);
            float z = center.z + ring_r * sin(phi);
            grid[i * lon_div + j] = addpoint(geo, set(x, y, z));
        }
    }
    
    for (int i = 0; i < lat_div; ++i) {
        for (int j = 0; j < lon_div; ++j) {
            int next_j = (j + 1) % lon_div;
            int p0 = grid[i * lon_div + j];
            int p1 = grid[i * lon_div + next_j];
            int p2 = grid[(i + 1) * lon_div + next_j];
            int p3 = grid[(i + 1) * lon_div + j];
            
            if (i == 0) {
                int pr = addprim(geo, \"poly\");
                addvertex(geo, pr, p3); addvertex(geo, pr, p2); addvertex(geo, pr, p0);
            } else if (i == lat_div - 1) {
                int pr = addprim(geo, \"poly\");
                addvertex(geo, pr, p2); addvertex(geo, pr, p1); addvertex(geo, pr, p0);
            } else {
                int pr = addprim(geo, \"poly\");
                addvertex(geo, pr, p3); addvertex(geo, pr, p2); addvertex(geo, pr, p1); addvertex(geo, pr, p0);
            }
        }
    }
}

function void add_newel_post(int geo; vector center_base; float height; float post_w) {
    float hw = post_w * 0.5;
    float collar_hw = post_w * 0.625;
    float collar_h = 0.06;
    
    add_box(geo, set(center_base.x - collar_hw, center_base.y, center_base.z - collar_hw),
                 set(center_base.x + collar_hw, center_base.y + collar_h, center_base.z + collar_hw));
                 
    add_box(geo, set(center_base.x - hw, center_base.y + collar_h, center_base.z - hw),
                 set(center_base.x + hw, center_base.y + height, center_base.z + hw));
                 
    float cap_y0 = center_base.y + height;
    float cap_hw1 = post_w * 0.60;
    float cap_h1 = 0.035;
    add_box(geo, set(center_base.x - cap_hw1, cap_y0, center_base.z - cap_hw1),
                 set(center_base.x + cap_hw1, cap_y0 + cap_h1, center_base.z + cap_hw1));
                 
    float cap_y1 = cap_y0 + cap_h1;
    float cap_hw2 = post_w * 0.45;
    float cap_h2 = 0.025;
    add_box(geo, set(center_base.x - cap_hw2, cap_y1, center_base.z - cap_hw2),
                 set(center_base.x + cap_hw2, cap_y1 + cap_h2, center_base.z + cap_hw2));
                 
    float ball_r = post_w * 0.35;
    vector ball_center = set(center_base.x, cap_y1 + cap_h2 + ball_r, center_base.z);
    add_sphere(geo, ball_center, ball_r);
}

function void add_sloping_rail(int geo; float x_center; float rail_w; float rail_h; vector p_top; vector p_bot) {
    vector dir = normalize(p_bot - p_top);
    vector normal_up = normalize(cross(dir, set(1, 0, 0)));
    vector normal_right = normalize(cross(normal_up, dir));
    
    float half_w = rail_w * 0.5;
    float half_h = rail_h * 0.5;
    
    vector v_u = normal_up * half_h;
    vector v_r = normal_right * half_w;
    
    int p[];
    resize(p, 8);
    p[0] = addpoint(geo, p_top - v_r - v_u);
    p[1] = addpoint(geo, p_top + v_r - v_u);
    p[2] = addpoint(geo, p_top + v_r + v_u);
    p[3] = addpoint(geo, p_top - v_r + v_u);
    p[4] = addpoint(geo, p_bot - v_r - v_u);
    p[5] = addpoint(geo, p_bot + v_r - v_u);
    p[6] = addpoint(geo, p_bot + v_r + v_u);
    p[7] = addpoint(geo, p_bot - v_r + v_u);
    
    int pr;
    // Start cap (-dir)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[3]);
    // End cap (+dir)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[5]);
    // Top (+up)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]);
    // Bottom (-up)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[1]);
    // Right (+right)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[2]);
    // Left (-right)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[4]);
}

// 9 October 2026 (Matthieu) : each rail is CENTRED on the clapboard strip between the outer corner post and the door jamb, not on the outer seam. strip centre = (outer half width + door half width) / 2. The steps keep the outer seam. FR : la rampe est centrée sur la bande de planches entre le poteau extérieur et la porte.
float door_w = ch(\"../../Component_PorchVestibule/door_width\");
float strip_c = ch(\"../../Component_PorchVestibule/porch_width\") * 0.5 - 0.0255;   // 9 October 2026 (Matthieu) : the rail newel is centred on the OUTER CORNER POST, trim_w 0.075 / trim_th 0.024. FR : poteau de rampe centré sur le poteau d'angle extérieur.
float x_offsets[2];
x_offsets[0] = -strip_c;
x_offsets[1] =  strip_c;

float z_top = post_w * 0.5 + ch(\"../porch_params/rail_wall_gap\");     // clear of the porch front face
float z_bot = float(N) * sr + ch(\"../porch_params/rail_foot_extra\");   // 9 October 2026 (Matthieu) : the foot newel sits further out so it no longer crops the last step. FR : le pilier du bas est plus loin, il ne coupe plus la dernière marche.

float y_top_base = landing_y;
float y_bot_base = 0.0;

for (int s = 0; s < 2; ++s) {
    float x = x_offsets[s];
    
    add_newel_post(0, set(x, y_top_base, z_top), rh, post_w);
    add_newel_post(0, set(x, y_bot_base, z_bot), sh + rh, post_w);
    
    vector top_rail_start = set(x, y_top_base + rh - 0.04, z_top + post_w*0.5);
    vector top_rail_end   = set(x, sh + rh - 0.04, z_bot - post_w*0.5);
    add_sloping_rail(0, x, 0.08, 0.06, top_rail_start, top_rail_end);
    
    vector bot_rail_start = set(x, y_top_base + 0.12, z_top + post_w*0.5);
    vector bot_rail_end   = set(x, sh + 0.12, z_bot - post_w*0.5);
    add_sloping_rail(0, x, 0.06, 0.04, bot_rail_start, bot_rail_end);
    
    float span_z = (z_bot - post_w*0.5) - (z_top + post_w*0.5);
    int num_bal = int(span_z / bal_sp);
    if (num_bal < 2) num_bal = 2;
    
    for (int b = 1; b <= num_bal; ++b) {
        float u = float(b) / float(num_bal + 1);
        float bz = (z_top + post_w*0.5) + u * span_z;
        
        float by_bot = (1.0 - u) * (y_top_base + 0.14) + u * (sh + 0.14);
        float by_top = (1.0 - u) * (y_top_base + rh - 0.07) + u * (sh + rh - 0.07);
        
        float hbw = bal_w * 0.5;
        add_box(0, set(x - hbw, by_bot, bz - hbw), set(x + hbw, by_top, bz + hbw));
    }
}
