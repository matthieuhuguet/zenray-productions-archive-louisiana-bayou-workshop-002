version 0.8
python	[ 0	locks=0 ]	(	"# 8 October 2026 : clean UV of the white paint clapboards, one band of the paint sheet per plank. EN: a plank maps to ONE plank of the sheet (between two lap grooves, margin kept), u follows the wall in metres, the offset is drawn per plank so no two planks show the same paint loss. FR : un clin = une planche de la feuille, entre deux joints.
import hou, random
geo = hou.pwd().geometry()
KIND = 'paint_church'
WHITE = 'M_PeelingWhiteWood_01'
GROOVES = [0.077, 0.195, 0.313, 0.435, 0.553, 0.671, 0.787, 0.897]   # lap shadow rows measured on the height sheet (v from the bottom)
MARGIN_V = 0.010
UV_PER_M = 0.63                                                      # one sheet width = 1.58 m of clapboard
if geo.findPrimAttrib('grp') is None: geo.addAttrib(hou.attribType.Prim, 'grp', '')
sel = [pr for pr in geo.prims() if pr.attribValue('material_id') == WHITE]
has_row = geo.findPrimAttrib('plank_row') is not None     # a clapboard row cut by an opening is several quads with the same plank_row
def plank_key(pr): return pr.attribValue('plank_row') if has_row else pr.attribValue('piece_id')
span = {}
for pr in sel:
    key = plank_key(pr); b = span.setdefault(key, [1e9, -1e9])
    for v in pr.vertices():
        y = v.point().position()[1]; b[0] = min(b[0], y); b[1] = max(b[1], y)
