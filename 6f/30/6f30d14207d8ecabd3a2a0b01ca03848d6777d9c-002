{
    vector d_pts[];
    resize(d_pts, 4);
    d_pts[0] = set(0.0, peak_y, 0.0);
    d_pts[1] = set(-half_w, wh, 0.0);
    d_pts[2] = d_pts[1] - N * deck_th;
    d_pts[3] = set(0.0, peak_y - deck_th / cos_p, 0.0);
    
