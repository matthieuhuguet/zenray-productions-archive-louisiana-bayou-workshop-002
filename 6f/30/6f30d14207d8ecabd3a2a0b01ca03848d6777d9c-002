import hou
geo = hou.pwd().geometry()
SET_CD = False   # in the church the windows keep the church colours; True gives the diagnostic colours
# group -> (piece id ranges, colour). Edit here only.
GROUPS = [
    ('frame',   [(1, 11)],                   (0.20, 0.40, 0.95)),
    ('sash',    [(100, 113)],                (0.10, 0.80, 0.80)),
    ('glass',   [(200, 211)],                (0.25, 0.80, 0.30)),
    ('rail',    [(300, 310), (351, 361)],    (0.95, 0.85, 0.10)),
    ('slat_L',  [(311, 350)],                (1.00, 0.50, 0.10)),
    ('slat_R',  [(362, 401)],                (0.90, 0.15, 0.20)),
]
NAME = {'frame': 'Frame', 'sash': 'Frame', 'glass': 'Glass', 'rail': 'Shutters', 'slat_L': 'Shutters', 'slat_R': 'Shutters'}
# 9 October 2026 : shape fallback, a piece outside the id table that looks like a louver slat is a slat (the tables ended at 401 and 243 and 96 slats fell into 'frame'). FR : repli par la forme : une pièce hors table qui a la forme d'une lamelle est une lamelle.
SIZES = {}
for _pr in geo.prims():
    _b = SIZES.setdefault(_pr.attribValue('piece_id'), [1e9] * 3 + [-1e9] * 3)
    for _v in _pr.vertices():
        _p = _v.point().position()
        for _i in range(3): _b[_i] = min(_b[_i], _p[_i]); _b[3 + _i] = max(_b[3 + _i], _p[_i])
def fallback(pid):
    b = SIZES.get(pid)
    if b is not None:
        a = sorted(b[3 + i] - b[i] for i in range(3))
        if 0.2 < a[2] < 0.45 and a[1] < 0.13 and a[0] < 0.035: return 'slat_R', (0.90, 0.15, 0.20)
    return 'frame', (0.5, 0.5, 0.5)
def find(pid):
    _fb = fallback(pid)
    if _fb[0] == 'slat_R': return _fb      # 9 October 2026 : the SHAPE decides first, 88 slats were listed as rails by the id table. FR : la forme décide d'abord.
    for gname, ranges, col in GROUPS:
        for a, b in ranges:
            if a <= pid <= b:
                if gname in ('slat_L', 'slat_R'): return 'rail', (0.95, 0.85, 0.10)      # 9 October 2026 : the id table put the whole right shutter (stiles, rails, hinges) in the slat group; only a SLAT SHAPE is a slat. FR : tout le volet droit (montants, traverses, charnières) était dans le groupe des lamelles.
                return gname, col
    return fallback(pid)
for nm, t, dv in (('grp', hou.attribType.Prim, ''), ('name', hou.attribType.Prim, '')):
