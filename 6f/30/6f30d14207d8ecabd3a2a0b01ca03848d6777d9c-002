for tx, ty, tz, ry in pts:
    p = geo.createPoint(); p.setPosition((tx, ty, tz))
    q = hou.Quaternion(); q.setToAngleAxis(ry, (0, 1, 0)); p.setAttribValue('orient', tuple(q))
