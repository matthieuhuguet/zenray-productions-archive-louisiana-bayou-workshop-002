float l_thick = ch(\"../louver_thickness\");
float l_depth = ch(\"../louver_depth\");
float recess = ch(\"../louver_recess\");

int pid = 200;

float total_opening_w = W - ifw*2.0;
float bay_w = (total_opening_w - mw) * 0.5;
float bay_h = H - ifw*2.0;

float left_bay_x = -mw*0.5 - bay_w*0.5;
float right_bay_x = mw*0.5 + bay_w*0.5;

float step_y = bay_h / float(count + 1);
float z_pos = -recess;

for (int k = 1; k <= count; k++) {
    float y_pos = ifw + float(k) * step_y;
    make_slat(set(left_bay_x, y_pos, z_pos), set(bay_w, l_thick, l_depth), louver_angle_deg, \"group_louvers\", pid++);
}

for (int k = 1; k <= count; k++) {
    float y_pos = ifw + float(k) * step_y;
    make_slat(set(right_bay_x, y_pos, z_pos), set(bay_w, l_thick, l_depth), louver_angle_deg, \"group_louvers\", pid++);
}

