// Invert curve_v with 8 Newton-Raphson iterations
float invert_curve_v(float v; float flare) {
    float u = v;
    for (int it = 0; it < 8; it++) {
        float f = (1.0 - flare) * u + flare * pow(u, 1.5) - v;
        float df = (1.0 - flare) + 1.5 * flare * sqrt(max(0.0001, u));
        u = clamp(u - f / df, 0.0, 1.0);
    }
    return u;
}

