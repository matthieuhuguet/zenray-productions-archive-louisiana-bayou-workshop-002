    if (is_left) u_val = pos.z + 3.0;
    else if (is_right) u_val = 3.0 - pos.z;
    else if (is_front) u_val = pos.x + 2.0;
    else if (is_rear) u_val = 2.0 - pos.x;
    
    min_u = min(min_u, u_val);
    max_u = max(max_u, u_val);
}

