// 2. SOLID 3D WEDGE SHINGLES WITH CLEAN BOUNDED CUT AT VERGE
void make_wedge_shingle(int geo; vector center; float L, W_sh, T_butt, T_head; int side; float pitch_ang; string grp_name; int piece) {
    float hx = L * 0.5;
    float hz = W_sh * 0.5;
    
    // U = tangent along roof slope pointing UP towards ridge
    // V = normal pointing OUTWARD from roof into sky
    // W_dir = cross(U, V), tangent along roof course (right-handed orthonormal basis)
    vector U, V, W_dir;
    if (side == -1) {
        V = set(-sin(pitch_ang), cos(pitch_ang), 0.0);
        U = set( cos(pitch_ang), sin(pitch_ang), 0.0);
    } else {
        V = set( sin(pitch_ang), cos(pitch_ang), 0.0);
        U = set(-cos(pitch_ang), sin(pitch_ang), 0.0);
    }
    W_dir = cross(U, V);
    
    // 8 points in (U, V, W_dir) frame:
    // U: -hx (butt, down-slope towards eave), +hx (head, up-slope towards ridge)
    // V: 0 (bottom at deck), T (top facing sky)
    // W_dir: -hz to +hz along course
    vector p[];
    resize(p, 8);
    p[0] = center - hx * U + 0.0    * V - hz * W_dir;
    p[1] = center + hx * U + 0.0    * V - hz * W_dir;
    p[2] = center + hx * U + 0.0    * V + hz * W_dir;
    p[3] = center - hx * U + 0.0    * V + hz * W_dir;
    p[4] = center - hx * U + T_butt * V - hz * W_dir;
    p[5] = center + hx * U + T_head * V - hz * W_dir;
    p[6] = center + hx * U + T_head * V + hz * W_dir;
    p[7] = center - hx * U + T_butt * V + hz * W_dir;
    
    int ipt[];
    resize(ipt, 8);
    for (int k = 0; k < 8; ++k) ipt[k] = addpoint(geo, p[k]);
    
    int pr0 = addprim(geo, \"poly\", ipt[5], ipt[6], ipt[7], ipt[4]); // Top face (+V: outward into sky)
    int pr1 = addprim(geo, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]); // Bottom face (-V: inward to deck)
    int pr2 = addprim(geo, \"poly\", ipt[4], ipt[7], ipt[3], ipt[0]); // Butt face (-U: down-slope towards eave)
    int pr3 = addprim(geo, \"poly\", ipt[2], ipt[6], ipt[5], ipt[1]); // Head face (+U: up-slope towards ridge)
    int pr4 = addprim(geo, \"poly\", ipt[1], ipt[5], ipt[4], ipt[0]); // -W face
    int pr5 = addprim(geo, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]); // +W face
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, piece);
    }
}

