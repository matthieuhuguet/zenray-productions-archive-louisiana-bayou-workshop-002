        float u_mid = 0.5 * (u_bot + u_top);
        
        vector pt_mid = get_roof_pt(u_mid, side, 0.0, hw_eave, ye, gh, flare);
        vector n_mid  = get_roof_norm(u_mid, side, hw_eave, gh, flare);
        
        float d_dx = hw_eave;
        float d_dy = gh * ((1.0 - flare) + 1.5 * flare * sqrt(max(0.001, u_mid)));
        float pitch_ang = atan2(d_dy, d_dx);
        
        matrix3 rot = ident();
        if (side == -1) {
            rotate(rot, pitch_ang, set(0, 0, 1));
        } else {
            rotate(rot, -pitch_ang, set(0, 0, 1));
        }
        
        float tw_min = ch(\"../tile_width_min\");   // 9 October 2026 : porch tile widths random in [0.09, 0.18] m, glued by a cursor
        float tw_max = ch(\"../tile_width_max\");
        float ref_cols = ch(\"../width_ref_cols\");
        float cursor = r_zb - rand(float(r) * 7.3 + float(side) * 11.0) * tw_max;
        
        for (int c = 0; c < 400; c++) {
            if (cursor > z_front_limit + 0.01) break;
            float seed = float(r * 41 + (c + 5) * 19 + side * 67);
            float w_tile = lerp(tw_min, tw_max, rand(seed + 1.0)) * (ref_cols / float(num_cols));
            float z_min = cursor;
            float z_max = cursor + w_tile - 0.003;
            cursor += w_tile;
            
            if (z_max <= z_back_limit || z_min >= z_front_limit) continue;
            
            float z0_clip = max(z_back_limit, z_min);
            float z1_clip = min(z_front_limit, z_max);
            float final_w = z1_clip - z0_clip;
            if (final_w < 0.025) continue;
            
            float final_z = 0.5 * (z0_clip + z1_clip);
            vector center = set(pt_mid.x, pt_mid.y, final_z) + n_mid * (deck_th + 0.001);
            
            make_wedge_shingle(0, center, sh_len, final_w, sh_th_butt, sh_th_head, side, pitch_ang, \"group_shingles\", pid++);
        }
    }
}

// 3. ARCHED RIDGE CAP TILES
void make_arched_ridge_tile(int geo; float z_center; float wing_w, tile_len, thickness; float pitch_angle, peak_y, h_sh; string grp_name; int pid) {
    float hz = tile_len * 0.5;
    int num_pts = 7;
    vector prof_top[];
    resize(prof_top, 7);
    vector prof_bot[];
    resize(prof_bot, 7);
    
    float cos_p = cos(pitch_angle);
    float sin_p = sin(pitch_angle);
    
    vector dir_l  = set(-cos_p, -sin_p, 0.0);
    vector dir_r  = set( cos_p, -sin_p, 0.0);
    vector norm_l = set(-sin_p,  cos_p, 0.0);
    vector norm_r = set( sin_p,  cos_p, 0.0);
    
    float r_in = 0.024;
    float r_out = r_in + thickness;
    float y_c = peak_y + max(0.004, (h_sh - r_in * 0.5) / cos_p);
    
    float pi_half = 1.57079632679;
    float theta_left  = pi_half + pitch_angle;
    float theta_right = pi_half - pitch_angle;
    
    prof_bot[0] = dir_l * wing_w + norm_l * h_sh + set(0, peak_y, 0);
    prof_top[0] = prof_bot[0] + norm_l * thickness;
    
    for (int k = 0; k < 5; ++k) {
        float t = float(k) / 4.0;
        float ang = theta_left + t * (theta_right - theta_left);
        float nx = cos(ang);
        float ny = sin(ang);
        prof_bot[k + 1] = set(nx * r_in,  y_c + ny * r_in,  0.0);
        prof_top[k + 1] = set(nx * r_out, y_c + ny * r_out, 0.0);
    }
    
    prof_bot[6] = dir_r * wing_w + norm_r * h_sh + set(0, peak_y, 0);
    prof_top[6] = prof_bot[6] + norm_r * thickness;
    
    int pts_t0[]; resize(pts_t0, 7);
    int pts_b0[]; resize(pts_b0, 7);
    int pts_t1[]; resize(pts_t1, 7);
    int pts_b1[]; resize(pts_b1, 7);
    
    for (int i = 0; i < num_pts; ++i) {
        pts_t0[i] = addpoint(geo, prof_top[i] + set(0, 0, z_center - hz));
        pts_b0[i] = addpoint(geo, prof_bot[i] + set(0, 0, z_center - hz));
        pts_t1[i] = addpoint(geo, prof_top[i] + set(0, 0, z_center + hz));
        pts_b1[i] = addpoint(geo, prof_bot[i] + set(0, 0, z_center + hz));
    }
    
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(geo, \"poly\", pts_t0[i], pts_t0[i+1], pts_t1[i+1], pts_t1[i]);
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, pid);
    }
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(geo, \"poly\", pts_b1[i], pts_b1[i+1], pts_b0[i+1], pts_b0[i]);
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, pid);
    }
    int pr_l = addprim(geo, \"poly\", pts_b0[0], pts_t0[0], pts_t1[0], pts_b1[0]);
    setprimgroup(geo, grp_name, pr_l, 1);
    setprimattrib(geo, \"piece_id\", pr_l, pid);
    int pr_r = addprim(geo, \"poly\", pts_t0[6], pts_b0[6], pts_b1[6], pts_t1[6]);
    setprimgroup(geo, grp_name, pr_r, 1);
    setprimattrib(geo, \"piece_id\", pr_r, pid);
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr_f = addprim(geo, \"poly\", pts_b0[i], pts_b0[i+1], pts_t0[i+1], pts_t0[i]);
        setprimgroup(geo, grp_name, pr_f, 1);
        setprimattrib(geo, \"piece_id\", pr_f, pid);
        int pr_b = addprim(geo, \"poly\", pts_t1[i], pts_t1[i+1], pts_b1[i+1], pts_b1[i]);
        setprimgroup(geo, grp_name, pr_b, 1);
        setprimattrib(geo, \"piece_id\", pr_b, pid);
    }
}

float peak_pitch = atan2(gh * ((1.0 - flare) + 1.5 * flare), hw_eave);
int ridge_count = 0;   // 9 October 2026 : no inverted-gutter ridge cap, the slopes are cut flush at the ridge
float ridge_step = r_len / float(ridge_count);
float tile_len = ridge_step * 1.36;
float wing_w = 0.11;
float tile_th = 0.016;
float h_sh = deck_th + 0.008;

for (int i = 0; i < ridge_count; ++i) {
    float z_pos = r_zb + float(i) * ridge_step + ridge_step * 0.5;
    if (z_pos + tile_len * 0.5 > r_zf + 0.005) {
        z_pos = r_zf - tile_len * 0.5 + 0.005;
    }
    make_arched_ridge_tile(0, z_pos, wing_w, tile_len, tile_th, peak_pitch, yp + deck_th, h_sh, \"group_ridge_cap\", pid++);
}
