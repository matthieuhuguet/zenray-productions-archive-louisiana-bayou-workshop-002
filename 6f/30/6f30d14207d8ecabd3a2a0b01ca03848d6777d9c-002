    resize(b_pts, 4);
    b_pts[0] = set(0.0, peak_y - deck_th / cos_p, 0.0);
    b_pts[1] = set(-half_w, wh, 0.0) - N * deck_th;
    b_pts[2] = b_pts[1] - N * barge_w;
    b_pts[3] = set(0.0, b_pts[0].y - barge_w / cos_p, 0.0);
    
    make_symmetric_prism_z(b_pts, z_pos - barge_th * 0.5, z_pos + barge_th * 0.5, \"group_bargeboard\", pid++);
