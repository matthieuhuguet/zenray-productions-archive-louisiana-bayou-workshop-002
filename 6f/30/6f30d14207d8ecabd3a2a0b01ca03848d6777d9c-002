float j_thick = 0.025;
make_box(set(-W*0.5 + j_thick*0.5, H*0.5, -D*0.5), set(j_thick, H, D), \"group_frame\", pid++);
make_box(set( W*0.5 - j_thick*0.5, H*0.5, -D*0.5), set(j_thick, H, D), \"group_frame\", pid++);
