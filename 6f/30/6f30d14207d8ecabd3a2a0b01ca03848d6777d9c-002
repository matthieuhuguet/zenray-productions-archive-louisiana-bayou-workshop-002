    n = pr.normal(); ax = max(range(3), key=lambda i: abs(n[i]))
    uax, vax = {0: (2, 1), 1: (0, 2), 2: (0, 1)}[ax]
    pts = [v.point().position() for v in pr.vertices()]
    eu = max(p[uax] for p in pts) - min(p[uax] for p in pts); ev = max(p[vax] for p in pts) - min(p[vax] for p in pts)
