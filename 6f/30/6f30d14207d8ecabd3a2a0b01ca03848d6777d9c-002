make_box(set(0, -s_height*0.5, s_depth*0.5 - D*0.1), set(sill_w, s_height, s_depth + D*0.2), \"group_frame\", pid++);

// 5. Apron (decorative wooden board under sill)
float apron_w = W + cw*2.0;
make_box(set(0, -s_height - a_height*0.5, a_thick*0.5), set(apron_w, a_height, a_thick), \"group_frame\", pid++);
