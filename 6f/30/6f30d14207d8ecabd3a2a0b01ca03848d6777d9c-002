vector eave_ref = (p.x < 0.0) ? eave_l : eave_r;

float z_norm = p.z - r_zb;
float dist_slope = dot(p - eave_ref, T);

int is_checker = chi(\"../../debug_uv_01\") || chi(\"../../debug_uv_02\") || chi(\"../../debug_uv_all\") || chi(\"../../debug_uv_checker\");

// CRUCIAL TECH ART FIX : row_id calcule au centre de la PRIMITIVE (et non par vertex) !
// Cela evite le cisaillement diagonal de la texture sur les planches 3D !
vector pr_center = 0;
int nv = primvertexcount(0, pr);
for (int i = 0; i < nv; ++i) {
    pr_center += point(0, \"P\", vertexpoint(0, primvertex(0, pr, i)));
}
if (nv > 0) pr_center /= float(nv);

int row_id = int(floor(pr_center.y * 10.0 + 0.5));
float u_offset = is_checker ? 0.0 : rand(float(row_id) * 97.0 + 17.0) * 5.0;

vector n = normalize(prim_normal(0, pr, 0.5, 0.5));
vector2 uv_val = set(0.0, 0.0);

