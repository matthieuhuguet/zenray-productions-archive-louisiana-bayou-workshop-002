// Function to create a 3D box with group and piece_id
void make_box(vector center, size; string grp_name; int pid) {
    vector h = size * 0.5;
    vector p0 = center + set(-h.x, -h.y, -h.z);
    vector p1 = center + set( h.x, -h.y, -h.z);
    vector p2 = center + set( h.x,  h.y, -h.z);
    vector p3 = center + set(-h.x,  h.y, -h.z);
    vector p4 = center + set(-h.x, -h.y,  h.z);
    vector p5 = center + set( h.x, -h.y,  h.z);
    vector p6 = center + set( h.x,  h.y,  h.z);
    vector p7 = center + set(-h.x,  h.y,  h.z);
    
    int pt0 = addpoint(0, p0);
    int pt1 = addpoint(0, p1);
    int pt2 = addpoint(0, p2);
    int pt3 = addpoint(0, p3);
    int pt4 = addpoint(0, p4);
    int pt5 = addpoint(0, p5);
    int pt6 = addpoint(0, p6);
    int pt7 = addpoint(0, p7);
    
    int pr0 = addprim(0, \"poly\", pt3, pt2, pt1, pt0); // -Z (back)
    int pr1 = addprim(0, \"poly\", pt4, pt5, pt6, pt7); // +Z (front)
    int pr2 = addprim(0, \"poly\", pt0, pt1, pt5, pt4); // -Y (bottom)
    int pr3 = addprim(0, \"poly\", pt7, pt6, pt2, pt3); // +Y (top)
    int pr4 = addprim(0, \"poly\", pt0, pt4, pt7, pt3); // -X (left)
    int pr5 = addprim(0, \"poly\", pt1, pt2, pt6, pt5); // +X (right)
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
}

