snippet	[ 0	locks=0 ]	(	"// 9 October 2026 : porch ridge cut (same idea as the church): each slope's shingles are trimmed by the top surface of the opposite slope.
float W = ch(\"../porch_width\");
float flare = clamp(ch(\"../roof_flare\"), 0.0, 0.6);
float gh = ch(\"../gable_height\");
float hw_eave = W * 0.5 + 0.11 * ch(\"../../arch_scale\");
float yp = ch(\"../landing_y\") + ch(\"../wall_height\") + gh;
float p = atan2(gh * ((1.0 - flare) + 1.5 * flare), hw_eave);   // pitch at the ridge
float off = 0.02 + 0.012;
vector Q = set(0.0, yp + off, 0.0);
vector n_r = set(sin(p), cos(p), 0.0);
vector dir = set(cos(p), sin(p), 0.0);
vector c = {0,0,0}; int n = 0;
foreach (int vtx; primvertices(0, @primnum)) { c += point(0, \"P\", vertexpoint(0, vtx)); n++; }
c /= max(n, 1);
int mirror = (c.x > 0.0);
foreach (int vtx; primvertices(0, @primnum)) {
    int pt = vertexpoint(0, vtx);
    vector pos = point(0, \"P\", pt);
    if (mirror) pos.x = -pos.x;
    float d = dot(pos - Q, n_r);
    if (d > 0.0) pos -= dir * (d / dot(n_r, dir));
    if (mirror) pos.x = -pos.x;
    setpointattrib(0, \"P\", pt, pos);
}
