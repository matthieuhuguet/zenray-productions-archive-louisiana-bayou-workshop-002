float rafter_w = 0.065;
float rafter_d = 0.075;
float beam_z_positions[] = array(l * 0.5, -l * 0.5);

foreach (float z_beam; beam_z_positions) {
    vector r_pts[];
    resize(r_pts, 4);
    r_pts[0] = set(0.0, peak_y - deck_th / cos_p, 0.0);
    r_pts[1] = set(-half_w, wh, 0.0) - N * deck_th;
    r_pts[2] = set(-half_w, wh, 0.0) - N * (deck_th + rafter_d);
    r_pts[3] = set(0.0, peak_y - (deck_th + rafter_d) / cos_p, 0.0);
    
