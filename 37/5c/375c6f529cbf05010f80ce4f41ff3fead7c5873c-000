if SCRIPTS not in sys.path:
    sys.path.insert(0, SCRIPTS)
import MaskMeasure as MM  # noqa: E402
import PassLoop as PL  # noqa: E402
import Planche as PN  # noqa: E402

VERS = MM.BASE + 'versions/window/'
THUMBS = VERS + 'thumbs/'
PASSES = MM.BASE + 'measures/passes.jsonl'
OUT_HTML = VERS + 'planche_16x4_v4.html'
REF_FULL_REL = '../../refs/window_height_ref.png'  # 10 October 2026 : relative to versions/window/. FR : chemin relatif.
THUMB_PX = 640


def make_thumb(src, dst):
    # 10 October 2026 : 640 px grayscale JPEG, so the grid loads fast; the lightbox loads the full PNG. EN. FR : vignette 640 px.
    im = Image.open(src).convert('L').resize((THUMB_PX, THUMB_PX), Image.LANCZOS)
    im.save(dst, quality=90)


def fmt(value):
    return f'{value:.3f}'.replace('.', ',')


def signed(value):
    return f'{value:+.3f}'.replace('.', ',')


def fmt1(value):
    return f'{value:.1f}'.replace('.', ',')


def cls(value, target):
    # 10 October 2026 : green within 0.03 of the target, amber within 0.08, red beyond. EN. FR : vert, orange, rouge.
    dev = abs(value - target)
    if dev <= 0.03:
        return 'good'
    if dev <= 0.08:
        return 'near'
    return 'far'


def main():
    hi, lo, targets = PL.reference_targets()
    size = MM.load_size()
    regs = MM.region_masks(size[1], size[0])

    def fractions(png):
        a = MM.load(png, size)
        return {r: {'L': float((a[m] > hi).mean()), 'D': float((a[m] < lo).mean())} for r, m in regs.items()}

    recs = {}
    for line in open(PASSES):
        r = json.loads(line)
        if r.get('series') == 'v4' and r.get('status') == 'ok':
            recs[(r['method'], r['phase'])] = r

    os.makedirs(THUMBS, exist_ok=True)
    make_thumb(MM.REF, THUMBS + 'reference.jpg')

    t_conc_l = targets['top']['L'] - targets['lames']['L']
    t_conc_d = targets['top']['D'] - targets['lames']['D']
    items = []

    def stat_lines(fm, is_ref):
        out = []
        for label, key in (('haut', 'top'), ('lames', 'lames'), ('carré', 'carre')):
            vl, vd = fm[key]['L'], fm[key]['D']
            cl = 'ref' if is_ref else cls(vl, targets[key]['L'])
            cd = 'ref' if is_ref else cls(vd, targets[key]['D'])
            out.append(f'<div class="ln"><span class="lab">{label}</span><span class="v {cl}">L {fmt(vl)}</span><span class="v {cd}">D {fmt(vd)}</span></div>')
        conc_l = fm['top']['L'] - fm['lames']['L']
        conc_d = fm['top']['D'] - fm['lames']['D']
        cl = 'ref' if is_ref else cls(conc_l, t_conc_l)
        cd = 'ref' if is_ref else cls(conc_d, t_conc_d)
        out.append(f'<div class="ln conc"><span class="lab">concentration</span><span class="v {cl}">L {signed(conc_l)}</span><span class="v {cd}">D {signed(conc_d)}</span></div>')
        return ''.join(out)

    def info_text(fm):
        parts = []
        for label, key in (('haut', 'top'), ('lames', 'lames'), ('carré', 'carre')):
            parts.append(f"{label} L {fmt(fm[key]['L'])} (cible {fmt(targets[key]['L'])}), D {fmt(fm[key]['D'])} (cible {fmt(targets[key]['D'])})")
        conc_l = fm['top']['L'] - fm['lames']['L']
        conc_d = fm['top']['D'] - fm['lames']['D']
        parts.append(f"concentration {signed(conc_l)} / {signed(conc_d)} (cible {signed(t_conc_l)} / {signed(t_conc_d)})")
        return ' | '.join(parts)

    def figure(thumb_rel, full_rel, title, fm, is_ref):
        idx = len(items)
        items.append({'src': full_rel, 'title': title, 'info': info_text(fm), 'isRef': is_ref})
        return (f'<figure><img src="{thumb_rel}" data-idx="{idx}" alt="{html.escape(title)}" loading="lazy">'
                f'<figcaption>{stat_lines(fm, is_ref)}</figcaption></figure>')

    rows = []
    head = ('<section class="row head"><div class="label hd">Méthode</div>'
            '<div class="hd">Référence (cibles)</div><div class="hd">P1 uniforme</div>'
            '<div class="hd">P2</div><div class="hd">P3</div><div class="hd">P4</div></section>')
    for mid, name, verdict in PN.METHODS:
        p2 = recs[(mid, 2)]
        cooks = [recs[(mid, p)]['cook_s'] for p in (2, 3, 4) if (mid, p) in recs]
        meta = f"{p2['families']} fam. · {p2['nodes']} nodes · {fmt1(min(cooks))} à {fmt1(max(cooks))} s"
        label = (f'<div class="label"><div class="id">{mid}</div><div class="name">{html.escape(name)}</div>'
                 f'<div class="meta">{meta}</div><div class="verdict">{html.escape(verdict)}</div></div>')
        cells = [figure('thumbs/reference.jpg', REF_FULL_REL, f'{mid} · Référence (cibles)', targets, True)]
        for k in range(1, 5):
            png = VERS + mid + '/P%d.png' % k
            thumb_rel = f'thumbs/{mid}_P{k}.jpg'
            make_thumb(png, VERS + thumb_rel)
            cells.append(figure(thumb_rel, f'{mid}/P{k}.png', f'{mid} · P{k} · {name}', fractions(png), False))
        rows.append(f'<section class="row">{label}{"".join(cells)}</section>')

    page = PAGE.replace('__ROWS__', head + '\n'.join(rows)).replace('__ITEMS__', json.dumps(items, ensure_ascii=False))
    with open(OUT_HTML, 'w', encoding='utf-8') as fh:
        fh.write(page)
    print(OUT_HTML, os.path.getsize(OUT_HTML), 'bytes,', len(items), 'images')


