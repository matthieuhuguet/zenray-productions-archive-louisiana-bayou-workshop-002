def make_thumb(src, dst):
    # 10 October 2026 : 640 px grayscale JPEG for the grid; the viewer loads the full PNG. EN. FR : vignette 640 px.
    im = Image.open(src).convert('L').resize((THUMB_PX, THUMB_PX), Image.LANCZOS)
    im.save(dst, quality=90)


def fmt(value):
    return f'{value:.3f}'.replace('.', ',')


def signed(value):
    return f'{value:+.3f}'.replace('.', ',')


def fmt1(value):
    return f'{value:.1f}'.replace('.', ',')


def cls(value, target):
    # 10 October 2026 : green within 0.03 of the target, amber within 0.08, red beyond. EN. FR : vert, orange, rouge.
    dev = abs(value - target)
    if dev <= 0.03:
        return 'good'
    if dev <= 0.08:
        return 'near'
    return 'far'


def stat_lines(fm, targets, t_conc, is_ref):
    out = []
    for label, key in (('haut', 'top'), ('lames', 'lames'), ('carré', 'carre')):
        vl, vd = fm[key]['L'], fm[key]['D']
        cl = 'ref' if is_ref else cls(vl, targets[key]['L'])
        cd = 'ref' if is_ref else cls(vd, targets[key]['D'])
        out.append(f'<div class="ln"><span class="lab">{label}</span><span class="v {cl}">L {fmt(vl)}</span><span class="v {cd}">D {fmt(vd)}</span></div>')
    conc_l = fm['top']['L'] - fm['lames']['L']
    conc_d = fm['top']['D'] - fm['lames']['D']
    cl = 'ref' if is_ref else cls(conc_l, t_conc[0])
    cd = 'ref' if is_ref else cls(conc_d, t_conc[1])
    out.append(f'<div class="ln conc"><span class="lab">conc.</span><span class="v {cl}">L {signed(conc_l)}</span><span class="v {cd}">D {signed(conc_d)}</span></div>')
    return ''.join(out)


def info_text(fm, targets, t_conc):
    parts = []
    for label, key in (('haut', 'top'), ('lames', 'lames'), ('carré', 'carre')):
        parts.append(f"{label} L {fmt(fm[key]['L'])} (cible {fmt(targets[key]['L'])}), D {fmt(fm[key]['D'])} (cible {fmt(targets[key]['D'])})")
    conc_l = fm['top']['L'] - fm['lames']['L']
    conc_d = fm['top']['D'] - fm['lames']['D']
    parts.append(f"concentration {signed(conc_l)} / {signed(conc_d)} (cible {signed(t_conc[0])} / {signed(t_conc[1])})")
    return ' | '.join(parts)


def context_html(f):
    # 10 October 2026 : the context sheet of one pass, as readable lines. EN. FR : contexte de la passe.
    n = f['N']
    cov = f['couverture_utilisee']
    prev = f['couverture_precedente']
    prev_txt = (f"P {prev['top']['P']:.3f} / H {prev['top']['H']:.3f}".replace('.', ',')) if prev else 'aucune (passe 1)'
    lines = [
        f"Passe P{f['passe']} · {html.escape(str(f['date']))} · série {html.escape(str(f['serie']))}",
        f"N : {n['familles']} familles, {n['nodes']} nodes ; construction {fmt1(n['construction_s'])} s, recalcul {fmt1(n['recalcul_s'])} s",
        f"Finition : lèvre {f['finition']['lip_w']}, peinture {f['finition']['paint_amp']}, trou {f['finition']['hole_amp']}",
        f"Couverture utilisée, haut : P {cov['top']['P']:.3f} / H {cov['top']['H']:.3f}".replace('.', ','),
        f"Couverture précédente, haut : {prev_txt}",
        f"Contrôleur : {html.escape(f['controleur'])}",
        f"Fichiers : PNG {html.escape(f['fichiers']['png'])}",
        f"Spec : {html.escape(f['fichiers']['spec'])}",
        f"Masques : {html.escape(f['fichiers']['masques'])}",
    ]
    return ''.join(f'<div>{line}</div>' for line in lines)


# 10 October 2026, 22:53 : header of the three comparison rows placed above the grid. EN. FR : en-tête des trois lignes de comparaison, au-dessus de la grille.
COMPARE_HEAD = ('<section class="row compare head"><div class="label hd">Comparaison</div>'
                '<div class="hd">Gauche : référence de hauteur</div><div class="hd">Droite : passe 8</div></section>')


def compare_row(mid, name, ref_idx, p8_idx):
    # 10 October 2026, 22:53 : one method, reference on the left, its final pass 8 on the right; both open the viewer. EN. FR : une méthode, référence à gauche, passe 8 à droite.
    return (f'<section class="row compare"><div class="label"><div class="id">{mid}</div>'
            f'<div class="name">{html.escape(name)}</div></div>'
            f'<figure><img src="thumbs/reference.jpg" data-idx="{ref_idx}" alt="Référence de hauteur" loading="lazy">'
            f'<figcaption>Référence de hauteur</figcaption></figure>'
            f'<figure><img src="thumbs/{mid}_P8.jpg" data-idx="{p8_idx}" alt="{mid}, passe 8" loading="lazy">'
            f'<figcaption>{mid}, passe 8</figcaption></figure></section>')


def main():
    hi, lo, targets = PL.reference_targets()
    t_conc = (targets['top']['L'] - targets['lames']['L'], targets['top']['D'] - targets['lames']['D'])
    os.makedirs(THUMBS, exist_ok=True)
    make_thumb(MM.REF, THUMBS + 'reference.jpg')
    items = []
    rows = []
    ref_idx = None  # 10 October 2026, 22:53 : lightbox index of the reference, shared by the comparison rows. EN. FR : index de la référence pour la comparaison.
    p8_items = {}  # 10 October 2026, 22:53 : lightbox index of each method's pass 8. EN. FR : index de la passe 8 de chaque méthode.
    head = ('<section class="row head"><div class="label hd">Méthode</div>'
            '<div class="hd">Référence (cibles)</div>' +
            ''.join(f'<div class="hd">P{k}</div>' for k in range(1, 9)) + '</section>')

    def figure(thumb_rel, full_rel, title, fm, is_ref, fiche, fid):
        idx = len(items)
        items.append({'src': full_rel, 'title': title, 'info': info_text(fm, targets, t_conc), 'isRef': is_ref})
        ctx = '' if is_ref else (f'<details><summary>contexte de la passe</summary>{context_html(fiche)}</details>'
                                 f'<textarea data-avis="{fid}" placeholder="ton avis à l\'œil sur cette passe"></textarea>')
        return (f'<figure><img src="{thumb_rel}" data-idx="{idx}" alt="{html.escape(title)}" loading="lazy">'
                f'<figcaption>{stat_lines(fm, targets, t_conc, is_ref)}</figcaption>{ctx}</figure>')

    for mid, name, verdict in METHODS:
        cells = [figure('thumbs/reference.jpg', REF_FULL_REL, f'{mid} · Référence (cibles)', targets, True, None, None)]
        if ref_idx is None:
            ref_idx = len(items) - 1
        meta_parts = []
        recul = []
        fams = []
        for k in range(1, 9):
            fid = f'{mid}_P{k}'
            fiche = json.load(open(FICHES + fid + '.json', encoding='utf-8'))
            thumb_rel = f'thumbs/{fid}.jpg'
            png_rel = f'{mid}/P{k}.png'
            make_thumb(VERS + png_rel, VERS + thumb_rel)
            recul.append(fiche['N']['recalcul_s'])
            fams.append(fiche['N']['familles'])
            cells.append(figure(thumb_rel, png_rel, f'{mid} · P{k} · {name}', fiche['fractions_mesurees'], False, fiche, fid))
            if k == 8:
                p8_items[mid] = len(items) - 1
        meta = f"P1 à P4 : {fams[0]} fam. ; P5 à P8 : {fams[-1]} fam. · recalcul {fmt1(min(recul))} à {fmt1(max(recul))} s"
        label = (f'<div class="label"><div class="id">{mid}</div><div class="name">{html.escape(name)}</div>'
                 f'<div class="meta">{html.escape(meta)}</div><div class="verdict">{html.escape(verdict)}</div></div>')
        rows.append(f'<section class="row">{label}{"".join(cells)}</section>')

    compare = ''.join(compare_row(mid, name, ref_idx, p8_items[mid]) for mid, name, _ in METHODS)
    page = (PAGE.replace('__ROWS__', COMPARE_HEAD + compare + head + '\n'.join(rows))
                .replace('__ITEMS__', json.dumps(items, ensure_ascii=False)))
    with open(OUT, 'w', encoding='utf-8') as fh:
        fh.write(page)
    print(OUT, os.path.getsize(OUT), 'bytes,', len(items), 'items')


