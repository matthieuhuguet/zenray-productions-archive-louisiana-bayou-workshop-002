                multiparm {
                    name    "octane_objprop_TSVRulesA_RULE_COUNT"
                    label    "Trace Set Visibility Rule"
                    default 0

                    parm {
                        name    "octane_objprop_TSVRulesexclude_#"
                        label   "Exclude"
                        type    string
                        default { "" }
                        help    "Comma-separated list of names of trace sets to be treated as invisible for future hits in light paths that hit this object.\n\nAny object that is a member of any of these trace sets will be excluded. For example, setting this to \"grass,ball\" on a mirror object means any objects that are members of the \"grass\" or \"ball\" trace sets (or both) will not be reflected in the mirror.\n\nIf the text starts with a hyphen, all objects will be excluded unless they are a member of any of the listed trace sets. For example, setting this to \"-grass,ball\" on a mirror object means any objects that are members of neither the \"grass\" trace set nor the \"ball\" trace set (including objects that are not members of any trace sets) will not be reflected in the mirror. Setting this to simply \"-\" means that all objects will be excluded.\n\nA trace set name can be any text that does not contain a comma. Spaces are ignored at the start and end of trace set names, and empty trace set names are ignored. Trace set names are case-sensitive."
                        parmtag { "script_action" "import octane_objectparmutils\n\nparm = kwargs[\"parmtuple\"][0]\noctane_objectparmutils.traceSetSelector(parm)" }
                        parmtag { "script_action_icon" "BUTTONS_flatlist" }
                    }
                    parm {
                        name    "octane_objprop_TSVRulesreinclude_#"
                        label   "Reinclude"
                        type    string
                        default { "" }
                        help    "Comma-separated list of names of trace sets to be treated as visible again for future hits in light paths that hit this object, after potentially having been excluded by an earlier bounce.\n\nFor example, if a cube is excluded by a mirror, but reincluded by a metal ball, the cube will not be visible in the mirror (or the mirror's reflection in the metal ball), but will still be visible in the metal ball's reflection in the mirror.\n\nAll trace sets listed will be no longer excluded. If the text starts with a hyphen, all trace sets except the ones listed will be no longer excluded (and all objects that are not members of any trace sets will be no longer excluded). Note that a trace set being no longer excluded does not necessarily mean that all objects that are members of that trace set will be no longer excluded, because those objects could also be a member of a different trace set that is still excluded.\n\nSetting this to simply \"-\" means that all objects will be no longer excluded.\n\nFor each rule, reinclusions are applied after exclusions. This means reinclusions take priority if there is any conflict between the two.\n\nA trace set name can be any text that does not contain a comma. Spaces are ignored at the start and end of trace set names, and empty trace set names are ignored. Trace set names are case-sensitive."
                        parmtag { "script_action" "import octane_objectparmutils\n\nparm = kwargs[\"parmtuple\"][0]\noctane_objectparmutils.traceSetSelector(parm)" }
                        parmtag { "script_action_icon" "BUTTONS_flatlist" }
                    }
                    parm {
                        name    "octane_objprop_TSVRulesapplyToBounceTypes_#"
                        label   "Apply to bounce types"
                        type    buttonstrip
                        default { "15" }
                        help    "The types of light path bounce on this object that this rule should apply to.\n\nWhen a light path hits this object, any ray(s) that bounce off will do so with all applicable trace set visibility rules applied, depending on the type of the bounce.\n\nFor example, a rule that only applies to shadow bounces will only affect which objects can cast shadows on this object, and a rule that only applies to reflection bounces will only affect which objects can be visible in reflections on this object.\n\nReflection: specular (and glossy) reflection bounces.\nRefraction: specular (and glossy) transmission bounces.\nDiffuse: diffuse bounces (reflection and transmission), volume scatter bounces and bounces for tracing dirt, curvature and round edges.\nShadow: direct light bounces and bounces for tracing ambient occlusion."
                        menutoggle {
                            "1" "Reflection"
                            "2" "Refraction"
                            "4" "Diffuse"
                            "8" "Shadow"
                        }
                    }
                    parm {
                        name    "octane_objprop_TSVRulesapplyToFutureHits_#"
                        label   "Apply to future hits"
                        type    string
                        default { "3" }
                        help    "How this rule should take effect in the future of the light path.\n\n\"All future hits\" is the simplest value, and means that after a bounce to which this rule applies, this rule will update trace set visibility for the light path.\n\n\"Next hit only\" means that this rule only applies when considering the next hit after the current bounce, and the future of the light path after that will be as if this rule did not apply. For example, this can be used to exclude an object from direct reflections without changing anything for indirect reflections (an alternative may be to manually reinclude the relevant trace sets on all the indirect reflectors). This mimics the behavior of some other renderers and is primarily provided for users familiar with that behavior.\n\n\"All future hits after next hit\" is the opposite of \"Next hit only\", and means that this rule only applies when considering the future of the light path after the next hit, and trace set visibility for the next hit itself will be as if this rule did not apply. For example, this can be used to exclude an object from indirect reflections without changing anything for direct reflections (an alternative may be to manually exclude the relevant trace sets on all the indirect reflectors).\n\nNote that shadow bounces only continue for a single hit after the bounce, so for shadow bounces there is no difference between \"All future hits\" and \"Next hit only\", and a rule that only applies to \"All future hits after next hit\" will never apply to a shadow bounce."
                        menu {
                            "3"             "All future hits"
                            "_separator_"   "_separator_"
                            "1"             "Next hit only"
                            "2"             "All future hits after next hit"
                        }
                    }
                }

