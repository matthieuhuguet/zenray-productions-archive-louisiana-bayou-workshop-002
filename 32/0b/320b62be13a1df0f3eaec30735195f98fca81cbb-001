                    default { "0" }
                    help    "Bias added to the Gaussian splats scale. Increase it to make thin lines such as text more clearly visible. Note: it may negatively affect rendering performance."
                    range   { 0 0.01 }
                }
                parm {
                    name    "octane_objprop_gscovarianceScale"
                    label   "Covariance scale"
                    type    float
                    default { "1" }
                    help    "Scale multiplier of the Gaussian splats."
                    range   { 0 2 }
                }
                parm {
                    name    "octane_objprop_gsintensity"
                    label   "Intensity"
                    type    float
                    default { "1" }
                    help    "The Gaussian splats color will be multiplied by this value."
                    range   { 0 2 }
                }
                parm {
                    name    "octane_objprop_gsflipAxes"
                    label   "Flip axes"
                    type    toggle
                    default { "0" }
                    help    "Inverts the Gaussian splat X and Y axes (scale by -1)."
