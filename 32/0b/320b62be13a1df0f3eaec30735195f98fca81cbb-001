                parm {
                    name    "octane_objprop_gsalphaMin"
                    label   "Alpha min"
                    type    float
                    default { "0.01" }
                    help    "Regions of the Gaussian splats with alpha smaller than this will be invisible. Setting it to higher values will produce better performance but worse visual quality."
