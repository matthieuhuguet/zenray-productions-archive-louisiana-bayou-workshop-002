                        "1" "XZY"
                        "2" "YXZ"
                        "3" "YZX"
                        "4" "ZXY"
                        "5" "ZYX"
                    }
                    range   { 0! 5! }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_TRANSLATION"
                    label   "Translation"
                    type    vector
                    size    3
                    default { "0" "0" "0" }
                    help    "Translation applied to the clipping primitive (either box or ellipsoid)."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_ROTATION"
                    label   "Rotation"
                    type    vector
                    size    3
                    default { "0" "0" "0" }
                    help    "Rotation applied to the clipping primitive (either box or ellipsoid)."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_SCALE"
                    label   "Scale"
                    type    vector
                    size    3
                    default { "1" "1" "1" }
                    help    "Scale applied to the clipping primitive (either box or ellipsoid). \n E.g. setting scale to (10, 10, 10) will make a clipping primitive with dimensions (10, 10, 10) centered at the origin of Gaussian splat cloud local space."
                    range   { 0 1 }
                }
                parm {
                    name    "sepparm18"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "octane_objprop_gsclipCreateControl"
                    label   "Create Control Object"
                    type    button
                    joinnext
                    default { "0" }
                    help    "Creates a control null and links it via a python expression."
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingNullCreator(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "octane_objprop_gsclipLinkControl"
                    label   "Link Control Object"
                    type    button
                    joinnext
                    default { "0" }
                    help    "Links clipping parms to clipping control object. You can use this to link the clipping to any other object as well, but it won't have a guide or clipping mode parameter. For best results link to an \"Octane GS Clipping Control\" object"
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingNullLinker(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "octane_objprop_gsclipDeleteNull"
                    label   "Bake Transforms"
                    type    button
                    default { "0" }
                    help    "Bakes the current values of the control null into the local parameters. Be aware that this will not bake animations."
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingBakeTransforms(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm"
                    label   "Separator"
                    type    separator
                    default { "" }
                }
                parm {
                    name    "octane_objprop_gspriority"
                    label   "Clipping mat priority"
                    type    integer
                    default { "0" }
                    help    "The priority used to determine whether clipping material should clip this Gaussian splat cloud.\nClipping materials with lower or equal priority will be ignored.\nNote: intersection material is not supported when clipping Gaussian splats."
                    range   { -100 100 }
                }
