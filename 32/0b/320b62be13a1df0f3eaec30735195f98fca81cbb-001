                    help    "The way Gaussian splat cloud points are culled by clipping bounds.\n\n'None': no points are culled.\n'Box': points outside the specified clipping box primitive will be excluded from rendering.\n'Ellipsoid': points outside the specified clipping ellipsoid primitive will be excluded from rendering."
                    menu {
                        "0" "None"
                        "1" "Box"
                        "2" "Ellipsoid"
                    }
                }
                parm {
                    name    "sepparm19"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
