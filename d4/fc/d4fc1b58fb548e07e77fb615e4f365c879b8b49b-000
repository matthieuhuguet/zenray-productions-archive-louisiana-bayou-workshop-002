def layout(net):
    # 10 October 2026 : layout only, not counted in the passes. Planks from the measured row profile, the top region, the patch rectangle, and the four gates used by the families. FR : disposition seule.
    prof = json.load(open(B + 'measures/window_profile.json'))
    ry = T.node(net, 'ramp', 'A00_ramp__down_y', signature='f1', rotation=90.0, cycles=1.0, method=0)
    t = T.lin(net, 'A01_plank__t', ry, 0.0, 1.0)
    rx = T.node(net, 'ramp', 'A02_ramp__across_x', signature='f1', rotation=0.0, cycles=1.0, method=0)
    xs = T.lin(net, 'A03_across__s', rx, 0.0, 1.0)
    keys = [(prof['tau'][i], prof['median'][i]) for i in range(0, len(prof['tau']))]
    base = T.curve(net, 'B01_profile__median_row', t, keys, 1.0, 0.0, 1.0, T.SMOOTH)
    wood = T.smooth(net, 'B02_wood__presence', base, 0.18, 0.30)
    top = T.smooth(net, 'B03_top__region', t, 0.0, 0.33, 1.0, 0.0)
    not_top = T.lin(net, 'B04_not_top__region', top, 0.0, 1.0, 1.0, 0.0)
    px = T.smooth(net, 'G01_patch__x0', xs, P['patch_x0'] - 0.002, P['patch_x0'] + 0.002)
    px1 = T.smooth(net, 'G02_patch__x1', xs, P['patch_x1'] + 0.002, P['patch_x1'] - 0.002)
    py = T.smooth(net, 'G03_patch__y0', t, P['patch_y0'] - 0.002, P['patch_y0'] + 0.002)
    py1 = T.smooth(net, 'G04_patch__y1', t, P['patch_y1'] + 0.002, P['patch_y1'] - 0.002)
    patch = T.mix(net, 'G05_patch__mask', T.mix(net, 'G05a_patch__x', px, px1, 5), T.mix(net, 'G05b_patch__y', py, py1, 5), 5)
    not_patch = T.lin(net, 'G06_patch__outside', patch, 0.0, 1.0, 1.0, 0.0)
    gr = T.node(net, 'fractalnoise', 'C01_grain__streaks', [t], amp=P['grain_amp'], center=0.0,
                elementsize=P['grain_size'], elementsizetype=1, elementscalex=P['grain_sx'], elementscaley=1.0, offx=11.3)
    h0 = T.mix(net, 'C02_height__base', base, T.mix(net, 'C02a_grain__on_wood', gr, wood, 5), 3)
    # 10 October 2026 : continuous vertical grain inside the patch, in the base and not in a pass (fine streaks along the grain, no dark line). FR : grain vertical continu dans le carre, dans la base.
    vgrain = T.node(net, 'fractalnoise', 'C03_patch__vertical_grain', [t], amp=P['patch_grain_amp'], center=0.0,
                    elementsize=0.004, elementsizetype=1, elementscalex=1.0, elementscaley=12.0, offx=41.7)
    h0 = T.mix(net, 'C04_height__with_patch_grain', h0, T.mix(net, 'C04a_patch_grain__inside', vgrain, patch, 5), 3)
    low_wood = T.mix(net, 'D01_gate__low_wood', wood, not_top, 5)
    g_low = T.mix(net, 'D03_gate__low', low_wood, not_patch, 5)
    ctx = dict(
        t=t, xs=xs,
        g_all=wood,
        g_top=T.mix(net, 'D02_gate__top', wood, top, 5),
        g_low=g_low,
        g_patch=patch,
        # 10 October 2026 : louver ends, the strips at both sides of the sheet where the louvers turn into a bevel. FR : bouts des lames.
        g_lend=T.mix(net, 'D04_gate__louver_left_end', g_low, T.smooth(net, 'D05_x__left_end', xs, 0.028, 0.032, 1.0, 0.0), 5),
        g_rend=T.mix(net, 'D06_gate__louver_right_end', g_low, T.smooth(net, 'D07_x__right_end', xs, 0.968, 0.972, 0.0, 1.0), 5),
    )
    return ctx, h0


def fam(net, tag, h, drive, gate, size, sx, sy, off, fine, fine_size, t0, t1, width, amp):
    # 10 October 2026 : one family, exactly 8 nodes. EN: coarse noise, fine noise, their sum, a smooth threshold to a soft mask, the mask gated by a region, the signed distance of the gated mask (monotosdf), a rounded lip (smooth remap of the distance, plateau at amp), added to the height. The lip width is in canvas units. FR : une famille, 8 nodes ; la levre suit la distance, sans flou.
    n1 = T.node(net, 'fractalnoise', tag + '_coarse', [drive], amp=1.0, center=0.0,
                elementsize=size, elementsizetype=1, elementscalex=sx, elementscaley=sy, offx=off)
    n2 = T.node(net, 'fractalnoise', tag + '_fine', [drive], amp=fine, center=0.0,
                elementsize=fine_size, elementsizetype=1, elementscalex=1.0, elementscaley=1.0, offx=off * 1.7)
    nm = T.mix(net, tag + '_sum', n1, n2, 3)
    m = T.smooth(net, tag + '_mask', nm, t0, t1, 0.0, 1.0)
    g = T.mix(net, tag + '_gated', m, gate, 5)
    d = T.node(net, 'monotosdf', tag + '_sdf', [g], invert=P['invert'], iso=P['iso'])
    lip = T.smooth(net, tag + '_lip', d, 0.0, width, 0.0, amp)
    return T.mix(net, tag + '_apply', h, lip, 3)


def absfam(net, tag, h, drive, gate, size, sx, sy, off, fine, fine_size, t0, t1, width, level, mode):
    # 10 October 2026 : union family (M3b), exactly 8 nodes, no stacking. EN: coarse noise, fine noise, their sum, a smooth threshold to a soft mask, the mask gated by a region, its signed distance (monotosdf, invert 0 : inside is positive), a rounded lip that runs from the outside value (0 for paint, 1 for holes) to the absolute level inside, then max (mode 12, paint) or min (mode 13, holes) with the height. FR : union sans empilement, niveaux absolus, levre arrondie.
    n1 = T.node(net, 'fractalnoise', tag + '_coarse', [drive], amp=1.0, center=0.0,
                elementsize=size, elementsizetype=1, elementscalex=sx, elementscaley=sy, offx=off)
    n2 = T.node(net, 'fractalnoise', tag + '_fine', [drive], amp=fine, center=0.0,
                elementsize=fine_size, elementsizetype=1, elementscalex=1.0, elementscaley=1.0, offx=off * 1.7)
    nm = T.mix(net, tag + '_sum', n1, n2, 3)
    m = T.smooth(net, tag + '_mask', nm, t0, t1, 0.0, 1.0)
    g = T.mix(net, tag + '_gated', m, gate, 5)
    d = T.node(net, 'monotosdf', tag + '_sdf', [g], invert=0, iso=P['iso'])
    outside = 0.0 if mode == 12 else 1.0
    lip = T.smooth(net, tag + '_lip', d, 0.0, width, outside, level)
    return T.mix(net, tag + '_union', h, lip, mode)


def run_pass(net, h, ctx, spec, label):
    # 10 October 2026 : one pass = the families of spec, asserted to add exactly 64 nodes. FR : une passe = 64 nodes exactement.
    before = len(net.children())
    for item in spec:
        kind, name, gate_key = item[0], label + '_' + item[1], item[2]
        if kind == 'fam':
            h = fam(net, name, h, ctx['t'], ctx[gate_key], *item[3:])
        elif kind == 'abs':
            h = absfam(net, name, h, ctx['t'], ctx[gate_key], *item[3:])
        else:
            raise ValueError('unknown family kind ' + str(kind))
    added = len(net.children()) - before
    assert added == PASS_NODES, 'pass %s added %d nodes, expected %d' % (label, added, PASS_NODES)
    return h


