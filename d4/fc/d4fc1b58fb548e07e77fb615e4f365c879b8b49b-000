def _panel(built, out):
    ref = Image.open(B + REF).convert('L').resize((1254, 1254), Image.LANCZOS)
    mine = Image.open(built).convert('L').resize((1254, 1254), Image.LANCZOS)
    tile = Image.new('L', (1210, 1210), 90)
    s = 600
    tile.paste(ref.resize((s, s), Image.LANCZOS), (0, 0))
    tile.paste(mine.resize((s, s), Image.LANCZOS), (610, 0))
    tile.paste(ref.crop(ZOOM).resize((s, s), Image.NEAREST), (0, 610))
    tile.paste(mine.crop(ZOOM).resize((s, s), Image.NEAREST), (610, 610))
    tile.save(out)


def run(tag, passes=1, res=1254):
    # 10 October 2026 : builds layout plus the first `passes` passes, exports the height and its panel. FR : construit, exporte, planche.
    net = HL.fresh_net('H_WinSDF')
    ctx, h = layout(net)
    for i in range(passes):
        h = run_pass(net, h, ctx, SPECS[i], 'P%02d' % (i + 1))
    nodes = len(net.children())
    out = T.node(net, 'clamp', 'Z00_height__final', [h], dolowerlimit=1, lowerlimit=0.0, doupperlimit=1, upperlimit=1.0)
    os.makedirs(OUT, exist_ok=True)
    png = OUT + '%s.png' % tag
    HL.export_png(net, out, png, res)
    panel = OUT + 'panel_%s.png' % tag
    _panel(png, panel)
    return {'ok': True, 'image': png, 'panel': panel, 'nodes': nodes, 'passes': passes}


def run_specs(tag, pass_specs, res=1254):
    # 10 October 2026 : a fresh layout, then each pass spec in order; exports the height and its panel. FR : une variante fraiche, puis ses passes.
    net = HL.fresh_net('H_WinSDF')
    ctx, h = layout(net)
    for i, spec in enumerate(pass_specs):
        h = run_pass(net, h, ctx, spec, 'Q%02d' % (i + 1))
    # 10 October 2026 : finish, outside the passes (2 nodes): a fine streak grain over everything, so the flat paint keeps a fibre. FR : finition hors passes, grain fin sur tout.
    grain = T.node(net, 'fractalnoise', 'Y00_finish__grain_noise', [ctx['t']], amp=P['finish_amp'], center=0.0,
                   elementsize=P['grain_size'], elementsizetype=1, elementscalex=P['grain_sx'], elementscaley=1.0, offx=57.3)
    h = T.mix(net, 'Y01_finish__grain', h, grain, 3)
    nodes = len(net.children())
    out = T.node(net, 'clamp', 'Z00_height__final', [h], dolowerlimit=1, lowerlimit=0.0, doupperlimit=1, upperlimit=1.0)
    os.makedirs(OUT, exist_ok=True)
    png = OUT + '%s.png' % tag
    HL.export_png(net, out, png, res)
    panel = OUT + 'panel_%s.png' % tag
    _panel(png, panel)
    return {'ok': True, 'image': png, 'panel': panel, 'nodes': nodes, 'passes': len(pass_specs)}


def normalize(spec, paint=0.78, hole=0.34):
    # 10 October 2026 : three-tone variant (M3c). Every max family takes the one paint level, every min family the one hole level, so the height is wood, paint and holes, with no patchwork of plateaus. EN. FR : trois tons seulement (bois, peinture, trous).
    out = []
    for item in spec:
        it = list(item)
        it[-2] = paint if it[-1] == 12 else hole
        out.append(it)
    return out


# ---------------------------------------------------------------------------------------------
# Method M4 (10 October 2026) : masks first, one signed distance and one lip per target.
# Families only build masks and union them with max (no height is added per family, so nothing
# stacks and no plateau patchwork appears). The height is made once at the end from the two unions:
# paint lifted by a rounded lip, holes sunk by a rounded lip, on the continuous measured wood base.
# EN: pass = 8 mask families of 8 nodes = 64 nodes, asserted. FR : masques d'abord, une distance et une levre par cible.
# ---------------------------------------------------------------------------------------------

def mfam(net, tag, acc, drive, gate, size, sx, sy, off, fine, fine_size, t0, t1, ragged_amp, ragged_size):
    # 10 October 2026 : one mask family, exactly 8 nodes. EN: coarse noise, fine noise, their sum, a smooth threshold to a soft mask, the mask gated by a region, a ragged noise added to the gated mask (jagged edge), then max with the accumulated mask of the same target. FR : une famille de masque, union par max.
    n1 = T.node(net, 'fractalnoise', tag + '_coarse', [drive], amp=1.0, center=0.0,
                elementsize=size, elementsizetype=1, elementscalex=sx, elementscaley=sy, offx=off)
    n2 = T.node(net, 'fractalnoise', tag + '_fine', [drive], amp=fine, center=0.0,
                elementsize=fine_size, elementsizetype=1, elementscalex=1.0, elementscaley=1.0, offx=off * 1.7)
    nm = T.mix(net, tag + '_sum', n1, n2, 3)
    m = T.smooth(net, tag + '_mask', nm, t0, t1, 0.0, 1.0)
    g = T.mix(net, tag + '_gated', m, gate, 5)
    n3 = T.node(net, 'fractalnoise', tag + '_ragged', [drive], amp=ragged_amp, center=0.0,
                elementsize=ragged_size, elementsizetype=1, elementscalex=1.0, elementscaley=1.0, offx=off * 0.3 + 5.0)
    gj = T.mix(net, tag + '_jagged', g, n3, 3)
    return T.mix(net, tag + '_union', acc, gj, 12)


def finish_m4(net, h0, acc_p, acc_h):
    # 10 October 2026 : finish, outside the mask families. One signed distance and one rounded lip per target, then a fine grain. FR : finition unique par cible.
    d_p = T.node(net, 'monotosdf', 'F01_paint__sdf', [acc_p], invert=0, iso=P['iso'])
    lip_p = T.smooth(net, 'F02_paint__lip', d_p, 0.0, P['lip_w'], 0.0, P['paint_amp'])
    d_h = T.node(net, 'monotosdf', 'F03_hole__sdf', [acc_h], invert=0, iso=P['iso'])
    lip_h = T.smooth(net, 'F04_hole__lip', d_h, 0.0, P['lip_w'], 0.0, P['hole_amp'])
    h = T.mix(net, 'F05_height__with_paint', h0, lip_p, 3)
    h = T.mix(net, 'F06_height__minus_holes', h, lip_h, 4)
    grain = T.node(net, 'fractalnoise', 'Y00_finish__grain_noise', [h0], amp=P['finish_amp'], center=0.0,
                   elementsize=P['grain_size'], elementsizetype=1, elementscalex=P['grain_sx'], elementscaley=1.0, offx=57.3)
    return T.mix(net, 'F07_height__with_grain', h, grain, 3)


def run_m4(tag, pass_specs, res=1254):
    # 10 October 2026 : builds the M4 height from the layout, the mask passes (asserted 64 nodes each) and the finish. Exports and makes the panel. FR : construit, exporte, planche.
    net = HL.fresh_net('H_WinM4')
    ctx, h0 = layout(net)
    acc_p = T.const(net, 'M00_accumulator__paint0', ctx['t'], 0.0)
    acc_h = T.const(net, 'M00_accumulator__hole0', ctx['t'], 0.0)
    for i, spec in enumerate(pass_specs):
        label = 'R%02d' % (i + 1)
        before = len(net.children())
        for item in spec:
            kind, name, target, gate_key = item[0], label + '_' + item[1], item[2], item[3]
            assert kind == 'm', 'unknown mask family kind ' + str(kind)
            if target == 'P':
                acc_p = mfam(net, name, acc_p, ctx['t'], ctx[gate_key], *item[4:])
            else:
                acc_h = mfam(net, name, acc_h, ctx['t'], ctx[gate_key], *item[4:])
        added = len(net.children()) - before
        assert added == PASS_NODES, 'mask pass %s added %d nodes, expected %d' % (label, added, PASS_NODES)
    h = finish_m4(net, h0, acc_p, acc_h)
    nodes = len(net.children())
    out = T.node(net, 'clamp', 'Z00_height__final', [h], dolowerlimit=1, lowerlimit=0.0, doupperlimit=1, upperlimit=1.0)
    os.makedirs(OUT, exist_ok=True)
    png = OUT + '%s.png' % tag
    HL.export_png(net, out, png, res)
    panel = OUT + 'panel_%s.png' % tag
    _panel(png, panel)
    return {'ok': True, 'image': png, 'panel': panel, 'nodes': nodes, 'passes': len(pass_specs)}


