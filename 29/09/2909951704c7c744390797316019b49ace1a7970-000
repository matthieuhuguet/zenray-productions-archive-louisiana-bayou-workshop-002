def run(kind, module, configs, tag):
    import HeightLab as HL
    mod = importlib.import_module(module); importlib.reload(mod)
    res = []
    for i, cfg in enumerate(configs):
        net, out = mod.build(params=cfg)
        png = HL.BASE + 'versions/%s/sweep_%s_%d.png' % (kind, tag, i)
        HL.export_png(net, out, png)
        txt = HL.measure(kind, png)
        m = re.search(r'SCORE ([0-9.]+)', txt)
        res.append((float(m.group(1)) if m else -1, i, cfg))
    res.sort(key=lambda t: -t[0])
    return res
